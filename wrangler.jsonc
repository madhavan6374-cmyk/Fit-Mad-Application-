{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "fit-mad-application",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fit-mad-db",
      "database_id": "cc58b409-f5b8-40f5-8b2c-d882cbea7e89"
    }
  ]
}
